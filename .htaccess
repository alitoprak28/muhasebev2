# Kaya Plus - sunucu yapilandirmasi

# Ana sayfa artik kok adreste (index.html) sunuluyor.
# Eski adres kalici olarak koke yonlendirilir; boylece o adrese verilmis
# baglantilar ve arama motoru degeri korunur.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /kktc-sirket-kurma.html -> /
  RewriteCond %{THE_REQUEST} \s/+kktc-sirket-kurma\.html[\s?] [NC]
  RewriteRule ^ / [R=301,L]

  # www'suz tek surumde topla
  RewriteCond %{HTTP_HOST} ^www\.(.+)$ [NC]
  RewriteRule ^ https://%1%{REQUEST_URI} [R=301,L]
</IfModule>

# Dizin listelemesini kapat
Options -Indexes

# Statik dosyalar icin onbellek
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/png "access plus 1 month"
  ExpiresByType image/jpeg "access plus 1 month"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType text/css "access plus 1 week"
  ExpiresByType application/javascript "access plus 1 week"
  ExpiresByType video/mp4 "access plus 1 month"
</IfModule>
